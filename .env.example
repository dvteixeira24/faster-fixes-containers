# Replace the owner and repository with your public GHCR package.
GHCR_IMAGE=ghcr.io/dvteixeira24/faster-fixes-containers:latest

# Use a long URL-safe password (letters and digits) in this Compose setup.
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

DOMAIN_NAME=example.com
BASE_URL=https://example.com
BETTER_AUTH_URL=https://example.com
NEXT_PUBLIC_FF_API_ORIGIN=https://example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Public signup stays open unless this is true.
SIGNUP_EMAIL_WHITELIST_ENABLED=false
# Comma-separated exact email addresses used when the flag is true.
SIGNUP_EMAIL_WHITELIST=

# Supply a public bucket URL and S3-compatible credentials.
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=your-bucket
NEXT_PUBLIC_STORAGE_BASE_URL=https://your-public-bucket.example.com
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key

# Generate each independently with: openssl rand -hex 32
# The dashboard binds only to the VPS loopback interface.
INNGEST_PORT=8288
INNGEST_EVENT_KEY=replace-with-a-random-hex-event-key
INNGEST_SIGNING_KEY=replace-with-a-random-hex-signing-key
RESEND_API_KEY=your-resend-key
